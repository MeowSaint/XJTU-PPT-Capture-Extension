{
  "manifest_version": 3,
  "name": "课程 PPT 截取与 PDF 导出",
  "version": "3.2.0",
  "minimum_chrome_version": "114",
  "description": "从网页课程视频中提取 PPT 幻灯片，去重整理后导出 PDF 或图片包；支持思源学堂整课提取。",
  "permissions": ["storage", "webRequest", "scripting", "activeTab", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["https://rms-v5.xjtu.edu.cn/*", "https://api.github.com/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "打开 PPT 截取工具",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {"matches": ["https://rms-v5.xjtu.edu.cn/*"], "js": ["src/media.js", "src/course.js", "src/page-hook.js"], "run_at": "document_start", "all_frames": true, "world": "MAIN"},
    {"matches": ["https://rms-v5.xjtu.edu.cn/*"], "js": ["src/media.js", "src/course.js", "src/batch.js", "src/extension-state.js", "src/content.js"], "run_at": "document_start", "all_frames": true}
  ]
}
