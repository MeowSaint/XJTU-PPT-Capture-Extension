{
  "manifest_version": 3,
  "name": "课程 PPT 截取与 PDF 导出",
  "version": "2.1.1",
  "minimum_chrome_version": "114",
  "description": "手动选择课程视频，快速截取 PPT 并去重，检查页面后导出 PDF。",
  "permissions": ["storage", "webRequest", "scripting", "activeTab", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["https://rms-v5.xjtu.edu.cn/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "action": {
    "default_title": "打开 PPT 截取工具"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {"matches": ["https://rms-v5.xjtu.edu.cn/*"], "js": ["media.js", "page-hook.js"], "run_at": "document_start", "all_frames": true, "world": "MAIN"},
    {"matches": ["https://rms-v5.xjtu.edu.cn/*"], "js": ["media.js", "content.js"], "run_at": "document_start", "all_frames": true}
  ]
}
